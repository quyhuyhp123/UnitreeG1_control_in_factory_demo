#usda 1.0
(
    defaultPrim = "FactoryVariant"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FactoryVariant"
{
    def Xform "Factory" (
        prepend references = @../factory_layout_v2_physics.usd@
    )
    {
    }

    def Xform "Obstacles"
    {
        def Xform "shared_left_chair"
        {
            custom string navigation:kind = "static"
            custom bool navigation:routeTestObstacle = 1
            float xformOp:rotateZ = 180
            double3 xformOp:translate = (-7.00443518320535, -6.145246398582124, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Xform "Visual" (
                prepend references = @../props/chair/SM_Chair.usd@
            )
            {
                over "SM_Chair"
                {
                    bool physics:collisionEnabled = 0
                }
            }

            def Cube "Collider" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                token visibility = "invisible"
                double size = 1
                float3 xformOp:scale = (0.65, 0.65, 1.1)
                double3 xformOp:translate = (0, 0, 0.55)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "shared_left_person"
        {
            custom string navigation:kind = "human"
            custom bool navigation:routeTestObstacle = 1
            float xformOp:rotateZ = 180
            double3 xformOp:translate = (6.947900602747287, 0.32745796009477424, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Xform "Visual" (
                prepend references = @../props/worker/standing.usda@
            )
            {
            }

            def Cube "Collider" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                token visibility = "invisible"
                double size = 1
                float3 xformOp:scale = (0.65, 0.55, 1.85)
                double3 xformOp:translate = (0, 0, 0.925)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "route_1_center_box"
        {
            custom string navigation:kind = "static"
            custom bool navigation:routeTestObstacle = 1
            float xformOp:rotateZ = 180
            double3 xformOp:translate = (-0.06704922364705088, 6.85691626928581, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Cube "Collider" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                color3f[] primvars:displayColor = [(0.55, 0.32, 0.12)]
                double size = 1
                float3 xformOp:scale = (0.65, 0.65, 0.65)
                double3 xformOp:translate = (0, 0, 0.325)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "route_2_right_chair"
        {
            custom string navigation:kind = "static"
            custom bool navigation:routeTestObstacle = 1
            float xformOp:rotateZ = 270
            double3 xformOp:translate = (7.010009207474685, -6.423639667734092, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Xform "Visual" (
                prepend references = @../props/chair/SM_Chair.usd@
            )
            {
                over "SM_Chair"
                {
                    bool physics:collisionEnabled = 0
                }
            }

            def Cube "Collider" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                token visibility = "invisible"
                double size = 1
                float3 xformOp:scale = (0.65, 0.65, 1.1)
                double3 xformOp:translate = (0, 0, 0.55)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

    }
}

